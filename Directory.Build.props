<!-- SPDX-License-Identifier: MIT -->
<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <Authors>Yutamago</Authors>
        <Copyright>Copyright (c) 2026 Yutamago</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/yutamago/ffx-atel-sharp</RepositoryUrl>
        <Version>0.1.0-alpha</Version>
        <!-- Test assemblies one at a time (dotnet test); the corpus tests also lock against other checkouts. -->
        <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
    </PropertyGroup>
    <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
        <!-- The SDK package and the copy atel decompile writes carry these assemblies: map the checkout's
             path, so no PDB path names a user folder. -->
        <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
    </PropertyGroup>
    <PropertyGroup>
        <!-- Shared package versions. -->
        <RoslynVersion>5.0.0</RoslynVersion>
    </PropertyGroup>
</Project>
