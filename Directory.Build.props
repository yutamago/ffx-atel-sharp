<!-- SPDX-License-Identifier: MIT -->
<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <Authors>Yutamago</Authors>
        <Copyright>Copyright (c) 2026 Yutamago</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/yutamago/ffx-atel-sharp</RepositoryUrl>
        <!-- Every commit builds its own version, 0.1.0-alpha.0.<commits>.g<commit> (Directory.Build.targets,
             docs/sdk.md "Versions"); -p:Version=<version> overrides it (the release workflow). -->
        <AtelVersionBase>0.1.0-alpha.0</AtelVersionBase>
        <AtelVersionGiven Condition="'$(Version)' != ''">true</AtelVersionGiven>
        <Version Condition="'$(Version)' == ''">$(AtelVersionBase)</Version>
        <!-- Test assemblies one at a time (dotnet test); the corpus tests also lock against other checkouts. -->
        <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
    </PropertyGroup>
    <PropertyGroup>
        <!-- The generators in tools/ (dotnet run tools/gen-*.cs) find the checkout from their own path
             ([CallerFilePath]) and ship nowhere: no PathMap for them, as for the tests. -->
        <_AtelIsTool>false</_AtelIsTool>
        <_AtelIsTool Condition="'$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory)))' == '$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), tools))'">true</_AtelIsTool>
    </PropertyGroup>
    <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) And '$(_AtelIsTool)' != 'true'">
        <!-- The SDK package and the copy atel decompile writes carry these assemblies: map the checkout's
             path, so no PDB path names a user folder. -->
        <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
        <!-- Source Link's map in the PDBs uses the source root, not PathMap; deterministic source
             paths make it /_/ too. -->
        <DeterministicSourcePaths>true</DeterministicSourcePaths>
    </PropertyGroup>
    <PropertyGroup>
        <!-- Shared package versions. -->
        <RoslynVersion>5.0.0</RoslynVersion>
    </PropertyGroup>
</Project>
