<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>ATEL bytecode to Atel (C#) source.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
        <ProjectReference Include="../Ffx.Atel.Bytecode/Ffx.Atel.Bytecode.csproj" />
        <ProjectReference Include="../Ffx.Atel.Game/Ffx.Atel.Game.csproj" />
        <!-- The inline methods' templates, as the compiler reads them (docs/encoding.md, "Inline methods"). -->
        <ProjectReference Include="../Ffx.Atel.Compiler/Ffx.Atel.Compiler.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Hand-written names for workers, entries and variables (docs/source-repo.md, "Names"). -->
        <EmbeddedResource Include="../../data/names/**/*.toml" LogicalName="names/%(RecursiveDir)%(Filename)%(Extension)" />
        <!-- Hand-written names for library classes, by the signature of their code (docs/source-repo.md, "Library names"). -->
        <EmbeddedResource Include="../../data/library-names.toml" LogicalName="library-names.toml" />
        <!-- Hand-written English names (docs/plan.md, Decisions 2026-11-02). -->
        <EmbeddedResource Include="../../data/actor-names.json" LogicalName="actor-names.json" />
    </ItemGroup>
    <ItemGroup>
        <!-- Hand-written English names (docs/plan.md, Decisions 2026-11-02). -->
        <EmbeddedResource Include="../../data/areas.json" LogicalName="areas.json" />
    </ItemGroup>
</Project>
