<Project Sdk="Microsoft.NET.Sdk">
    <!-- The reference assembly Atel source compiles against: natives, properties, enums, base classes. -->
    <PropertyGroup>
        <Description>The game's API for Atel source: natives, properties, enums, Save, Story, Priority, worker base classes and the Task types.</Description>
        <RootNamespace>Ffx</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- atel decompile copies this assembly into the source it writes (.atel/), which goes into the
             private source repo: map the checkout's path so the PDB path in the DLL names no user folder. -->
        <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))=/_/</PathMap>
    </PropertyGroup>
</Project>
