<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod of the Besaid course: In Besaid village (bsvr0000), the F6 overlay shows the story progress and Tidus's position, every second. docs/sdk.md, examples/Besaid/README.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id: the build writes bin/<configuration>/net10.0/mods/yuta.whereami/. -->
        <AtelModId>yuta.whereami</AtelModId>
        <AtelModName>Where Am I</AtelModName>
        <Description>In Besaid village (bsvr0000), the F6 overlay shows the story progress and Tidus's position, every second. An example Atel mod.</Description>
        <Authors>Yutamago</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile bsvr0000 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
