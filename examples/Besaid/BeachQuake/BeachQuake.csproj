<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod of the Besaid course: The camera shakes as Tidus arrives on Besaid beach (bsil0000). docs/sdk.md, examples/Besaid/README.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id: the build writes bin/<configuration>/net10.0/mods/yuta.beachquake/. -->
        <AtelModId>yuta.beachquake</AtelModId>
        <AtelModName>Beach Quake</AtelModName>
        <Description>The camera shakes as Tidus arrives on Besaid beach (bsil0000). An example Atel mod.</Description>
        <Authors>Yutamago</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile bsil0000 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
