<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod of the Besaid course: Shows Besaid Tally's count when a Dingo (m009) appears. docs/sdk.md, examples/Besaid/README.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id, <author>.<mod>: put your own name or handle in place of your-name, in Authors too.
             The build writes bin/<configuration>/net10.0/mods/your-name.besaidtallyreader/. -->
        <AtelModId>your-name.besaidtallyreader</AtelModId>
        <AtelModName>Besaid Tally Reader</AtelModName>
        <Description>Shows Besaid Tally's count when a Dingo (m009) appears. An example Atel mod.</Description>
        <Authors>Your Name</Authors>
        <Version>0.1.0</Version>
        <!-- Fahrenheit loads it after the mod it reads, and needs both. -->
        <AtelModDependencies>yuta.atel;your-name.besaidtally</AtelModDependencies>
        <!-- The vanilla source this mod changes: the folder `atel decompile m009 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
