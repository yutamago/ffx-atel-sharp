<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod of the Besaid course: Below half HP, the Water Flan (m016) casts Water on itself, which heals it. docs/sdk.md, examples/Besaid/README.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id: the build writes bin/<configuration>/net10.0/mods/yuta.cleverflan/. -->
        <AtelModId>yuta.cleverflan</AtelModId>
        <AtelModName>Clever Flan</AtelModName>
        <Description>Below half HP, the Water Flan (m016) casts Water on itself, which heals it. An example Atel mod.</Description>
        <Authors>Yutamago</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile m016 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
