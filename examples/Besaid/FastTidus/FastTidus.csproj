<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod of the Besaid course: Tidus runs twice as fast on the Village Slope of Besaid (bsil0700). docs/sdk.md, examples/Besaid/README.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id, <author>.<mod>: put your own name or handle in place of your-name, in Authors too.
             The build writes bin/<configuration>/net10.0/mods/your-name.fasttidus/. -->
        <AtelModId>your-name.fasttidus</AtelModId>
        <AtelModName>Fast Tidus</AtelModName>
        <Description>Tidus runs twice as fast on the Village Slope of Besaid (bsil0700). An example Atel mod.</Description>
        <Authors>Your Name</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile bsil0700 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
