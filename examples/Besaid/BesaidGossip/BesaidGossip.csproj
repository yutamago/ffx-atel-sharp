<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod of the Besaid course: The old woman walking around Besaid village (bsvr0000) has a new line of gossip. docs/sdk.md, examples/Besaid/README.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id, <author>.<mod>: put your own name or handle in place of your-name, in Authors too.
             The build writes bin/<configuration>/net10.0/mods/your-name.besaidgossip/. -->
        <AtelModId>your-name.besaidgossip</AtelModId>
        <AtelModName>Besaid Gossip</AtelModName>
        <Description>The old woman walking around Besaid village (bsvr0000) has a new line of gossip. An example Atel mod.</Description>
        <Authors>Your Name</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile bsvr0000 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
