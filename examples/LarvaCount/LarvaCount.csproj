<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod: counts the Larvas (m209) met, kept with the save game. A [Saved] field. docs/sdk.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id: the build writes bin/<configuration>/net10.0/mods/yuta.larvacount/. -->
        <AtelModId>yuta.larvacount</AtelModId>
        <AtelModName>Larva Count</AtelModName>
        <Description>Counts the Larvas (m209) you meet, kept with each save. An example Atel mod with [Saved] fields.</Description>
        <Authors>Yutamago</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile m209 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
