<Project Sdk="AtelSharp.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- An Atel mod: after the Larva (m209) casts Thundara at full HP, its HP drops to 1. An [Inject]. docs/sdk.md -->
    <PropertyGroup>
        <!-- The Fahrenheit mod id: the build writes bin/<configuration>/net10.0/mods/yuta.larvainject/. -->
        <AtelModId>yuta.larvainject</AtelModId>
        <AtelModName>Larva Inject</AtelModName>
        <Description>After the Larva (m209) casts Thundara at full HP, its HP drops to 1. An example Atel mod with [Inject].</Description>
        <Authors>Yutamago</Authors>
        <Version>0.1.0</Version>
        <!-- The vanilla source this mod changes: the folder `atel decompile m209 -o <dir>` wrote. Never inside this project. -->
        <AtelVanillaSource Condition="'$(AtelVanillaSource)' == ''">../../../atel-vanilla</AtelVanillaSource>
    </PropertyGroup>
</Project>
