<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- For the ReSharper test framework (JetBrains' plugin template): the reference assemblies of the test projects it
     creates come from JetBrains' platform feed (it keeps them under ~/.local/share/JetBrains). -->
<configuration>
  <packageSources>
    <clear />
    <add key="resharper-platform" value="https://resharper-platform.jetbrains.com/api/v2/" />
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="False" />
  </packageRestore>
</configuration>
