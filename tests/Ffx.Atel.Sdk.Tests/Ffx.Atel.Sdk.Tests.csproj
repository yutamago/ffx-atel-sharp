<Project Sdk="Microsoft.NET.Sdk">
    <!-- SPDX-License-Identifier: MIT -->
    <!-- Packs AtelSharp.Sdk, AtelSharp.Templates and AtelSharp.Cli, installs the atel tool, and builds the example mods and a mod from the template with them, as a
         modder would (needs the game); checks the template's namespaces against the decompiler's. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    </ItemGroup>
    <ItemGroup>
        <!-- SourceNames and the area table, for the template's namespaces. -->
        <ProjectReference Include="../../src/Ffx.Atel.Decompiler/Ffx.Atel.Decompiler.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- The test packs the SDK in the configuration it was built in. -->
        <AssemblyMetadata Include="Configuration" Value="$(Configuration)" />
    </ItemGroup>
</Project>
