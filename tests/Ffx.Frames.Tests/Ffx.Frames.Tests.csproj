<Project Sdk="Microsoft.NET.Sdk">
    <!-- The frame mod's portable part: the tick accumulator, the plan, the director, the camera's, the characters' and the cloth's interpolation,
         the effects' replay rules, the settings and the hook checks on machine code. The mod itself builds against Fahrenheit for win-x86, so these
         sources are compiled in here directly (as the cuts' and the loader's tests do). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../../src/Ffx.Frames/TickAccumulator.cs" Link="TickAccumulator.cs" />
        <Compile Include="../../src/Ffx.Frames/TickPlan.cs" Link="TickPlan.cs" />
        <Compile Include="../../src/Ffx.Frames/FrameSettings.cs" Link="FrameSettings.cs" />
        <Compile Include="../../src/Ffx.Frames/FramePacing.cs" Link="FramePacing.cs" />
        <Compile Include="../../src/Ffx.Frames/FrameDirector.cs" Link="FrameDirector.cs" />
        <Compile Include="../../src/Ffx.Frames/CameraInterpolator.cs" Link="CameraInterpolator.cs" />
        <Compile Include="../../src/Ffx.Frames/FrameStats.cs" Link="FrameStats.cs" />
        <Compile Include="../../src/Ffx.Frames/TimeScaleSteps.cs" Link="TimeScaleSteps.cs" />
        <Compile Include="../../src/Ffx.Frames/CodeScan.cs" Link="CodeScan.cs" />
        <Compile Include="../../src/Ffx.Frames/EffectReplay.cs" Link="EffectReplay.cs" />
        <Compile Include="../../src/Ffx.Frames/CharacterInterpolator.cs" Link="CharacterInterpolator.cs" />
        <Compile Include="../../src/Ffx.Frames/ClothInterpolator.cs" Link="ClothInterpolator.cs" />
        <Compile Include="../../src/Ffx.Frames/WorldMatrixLog.cs" Link="WorldMatrixLog.cs" />
    </ItemGroup>
</Project>
